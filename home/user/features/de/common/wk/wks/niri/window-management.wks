# Niri-specific window management
# Extends common/window-management.wks with Niri features

c "Client"
{
    l "Workspace Down" +keep %{{%(CMD_WS_NEXT)}}
    L "Mon Right" %{{%(CMD_MOVE_TO_MONITOR_RIGHT)}}
    h "Workspace Up" +keep %{{%(CMD_WS_PREV)}}
    H "Mon Left" %{{%(CMD_MOVE_TO_MONITOR_LEFT)}}
    # Move to workspace
    m "Move to workspace" +keep
    {
        ... "Workspace %(index+1)" %{{%(CMD_MOVE_TO_WS) %(index+1)}}
    }
    q "Quit" %{{%(CMD_CLOSE_WINDOW)}}
    c "Center column" %{{niri msg action center-column}}
    f "Maximize" %{{niri msg action maximize-column}}
    t "Move to workspace"
    {
        ... "Workspace %(index+1)" %{{%(CMD_MOVE_TO_WS) %(index+1)}}
    }
}

w "Window"
{
    w "View workspace" +keep
    {
        ... "Workspace %(index+1)" %{{%(CMD_GO_WORKSPACE) %(index+1)}}
    }
    c "Consume into column" %{{niri msg action consume-window-into-column}}
    e "Expel from column" %{{niri msg action expel-window-from-column}}
    t "Toggle tabbed" %{{niri msg action toggle-column-tabbed-display}}
}
