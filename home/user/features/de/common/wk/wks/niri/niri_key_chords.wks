# Niri entry point for WK
# This file is used when launching wk from Niri
# It includes common bindings and Niri-specific window management

# Niri-specific variable definitions
# Workspace numbers
:var "WS_1" "1"
:var "WS_2" "2"
:var "WS_3" "3"
:var "WS_4" "4"
:var "WS_5" "5"
:var "WS_6" "6"
:var "WS_7" "7"
:var "WS_8" "8"
:var "WS_9" "9"

# Window management commands (using niri msg)
:var "CMD_CLOSE_WINDOW" "niri msg action close-window"
:var "CMD_TOGGLE_FLOAT" "niri msg action toggle-window-floating"
:var "CMD_TOGGLE_FULLSCREEN" "niri msg action fullscreen-window"

# Focus navigation
:var "CMD_FOCUS_NEXT" "niri msg action focus-column-right"
:var "CMD_FOCUS_PREV" "niri msg action focus-column-left"
:var "CMD_FOCUS_DOWN" "niri msg action focus-window-down"
:var "CMD_FOCUS_UP" "niri msg action focus-window-up"

# Workspace operations (parametric - use with %(index+1))
:var "CMD_SWITCH_WS" "niri msg action focus-workspace"
:var "CMD_GO_WORKSPACE" "niri msg action focus-workspace"
:var "CMD_MOVE_TO_WS" "niri msg action move-column-to-workspace"
:var "CMD_MOVE_FOLLOW_WORKSPACE" "niri msg action move-column-to-workspace"

# Relative workspace navigation
:var "CMD_WS_NEXT" "niri msg action focus-workspace-down"
:var "CMD_WS_PREV" "niri msg action focus-workspace-up"
:var "CMD_MOVE_NEXT" "niri msg action move-column-to-workspace-down"
:var "CMD_MOVE_PREV" "niri msg action move-column-to-workspace-up"

# Monitor operations
:var "CMD_MOVE_TO_MONITOR_LEFT" "niri msg action move-column-to-monitor-left"
:var "CMD_MOVE_TO_MONITOR_RIGHT" "niri msg action move-column-to-monitor-right"

# Screenshot utilities
:var "CMD_GET_WINDOW_GEOMETRY" "slurp"

# Workflow workspace assignments
:var "WS_EMACS" "2"
:var "WS_FIREFOX" "3"
:var "WS_GAMES" "4"
:var "WS_CHROMIUM" "4"
:var "WS_FEEDS" "5"
:var "WS_KEEPASSXC" "9"
:var "WS_SUPERSONIC" "9"

:include "../common/main.wks"
:include "window-management.wks"
