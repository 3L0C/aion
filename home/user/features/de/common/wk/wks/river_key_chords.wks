# River entry point for WK
# This file is used when launching wk from River
# It includes common bindings and River-specific window management

:include "main_key_chords.wks"

# River-specific variable definitions
# Window management commands
:var "CMD_CLOSE_WINDOW" "riverctl close"
:var "CMD_TOGGLE_FLOAT" "riverctl toggle-float"
:var "CMD_TOGGLE_FULLSCREEN" "riverctl toggle-fullscreen"

# Directional window focus/swap (River-specific)
:var "CMD_FOCUS_LEFT" "riverctl focus-view left"
:var "CMD_FOCUS_RIGHT" "riverctl focus-view right"
:var "CMD_FOCUS_UP" "riverctl focus-view up"
:var "CMD_FOCUS_DOWN" "riverctl focus-view down"
:var "CMD_SWAP_LEFT" "riverctl swap left"
:var "CMD_SWAP_RIGHT" "riverctl swap right"
:var "CMD_SWAP_UP" "riverctl swap up"
:var "CMD_SWAP_DOWN" "riverctl swap down"

# Tag operations using riverdo (parametric - use with %(index+1))
:var "CMD_SWITCH_WORKSPACE" "riverdo set-focused-tags"
:var "CMD_MOVE_TO_WORKSPACE" "riverdo set-view-tags"
:var "CMD_MOVE_FOLLOW_WORKSPACE" "riverdo set-view-tags"
:var "CMD_GO_WORKSPACE" "riverdo set-focused-tags"

# Relative tag navigation (riverdo)
:var "CMD_WORKSPACE_NEXT" "riverdo shift-tag next --occupied"
:var "CMD_WORKSPACE_PREV" "riverdo shift-tag previous --occupied"
:var "CMD_MOVE_NEXT" "riverdo shift-view next --occupied"
:var "CMD_MOVE_PREV" "riverdo shift-view previous --occupied"

# Monitor/output operations
:var "CMD_MOVE_TO_MONITOR_LEFT" "riverctl send-to-output left"
:var "CMD_MOVE_TO_MONITOR_RIGHT" "riverctl send-to-output right"

# Screenshot utilities (use slurp for window mode)
:var "CMD_GET_WINDOW_GEOMETRY" "slurp -w"

# Workflow workspace assignments (River uses tags 1-32)
:var "WS_EMACS" "2"
:var "WS_BROWSER_MULLVAD" "4"
:var "WS_FEEDS" "5"
:var "WS_GAMES" "4"

:include "river/window-management.wks"
