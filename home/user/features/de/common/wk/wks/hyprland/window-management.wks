# Hyprland-specific window management
# Extends common/window-management.wks with Hyprland features

c "Client"
{
    l "Workspace Right" +keep %{{%(CMD_WS_NEXT)}}
    L "Mon Right" %{{%(CMD_MOVE_TO_MONITOR_RIGHT)}}
    h "Workspace Left" +keep %{{%(CMD_WS_PREV)}}
    H "Mon Left" %{{%(CMD_MOVE_TO_MONITOR_LEFT)}}
    # Move to workspace & follow
    m "Move & follow" +keep
    {
        ... "Workspace %(index+1)" %{{%(CMD_MOVE_FOLLOW_WORKSPACE) %(index+1)}}
    }
    q "Quit" %{{%(CMD_CLOSE_WINDOW)}}
    p "Pin (float only)" %{{hyprctl dispatch pin}}
    t "Move to workspace"
    {
        ... "Workspace %(index+1)" %{{%(CMD_MOVE_TO_WS) %(index+1)}}
    }
}

w "Window"
{
    s "Swap monitors" %{{hyprctl dispatch swapactiveworkspaces 0 1}}
    w "View workspace" +keep
    {
        ... "Workspace %(index+1)" %{{%(CMD_GO_WORKSPACE) %(index+1)}}
    }
}
