# River 0.4.x entry point for WK
# Used when launching wk from River 0.4.x (with ocdwm).
# All actions go through octl (ocdwm's CLI).

# Workspace numbers — octl TAGS accept plain indices (1-32)
:var "WS_1" "1"
:var "WS_2" "2"
:var "WS_3" "3"
:var "WS_4" "4"
:var "WS_5" "5"
:var "WS_6" "6"
:var "WS_7" "7"
:var "WS_8" "8"
:var "WS_9" "9"

# Monitors (output-identity based; layout-independent)
:var "MONITOR_BENQ" "DP-3"
:var "MONITOR_AOC" "DP-1"
:var "MONITOR_HP" "HDMI-A-1"

# Window management commands
:var "CMD_CLOSE_WINDOW" "octl window close"
:var "CMD_TOGGLE_FLOAT" "octl window toggle floating"
:var "CMD_TOGGLE_FULLSCREEN" "octl window toggle fullscreen"

# Stack navigation
:var "CMD_FOCUS_NEXT" "octl window focus next"
:var "CMD_FOCUS_PREV" "octl window focus prev"
:var "CMD_FOCUS_DOWN" "octl window focus down"
:var "CMD_FOCUS_UP" "octl window focus up"
:var "CMD_SWAP_DOWN" "octl window shift next"
:var "CMD_SWAP_UP" "octl window shift prev"

# Tag operations (parametric — callers append a TAGS index)
:var "CMD_SWITCH_WS" "octl tag view"
:var "CMD_GO_WORKSPACE" "octl tag view"
:var "CMD_MOVE_TO_WS" "octl window tag set"

# Relative tag navigation
:var "CMD_WS_NEXT" "octl tag next --occupied"
:var "CMD_WS_PREV" "octl tag prev --occupied"
:var "CMD_MOVE_NEXT" "octl window tag shift next --occupied"
:var "CMD_MOVE_PREV" "octl window tag shift prev --occupied"

# Monitor/output operations (target monitors by identity, not position)
:var "CMD_MOVE_TO_BENQ" "octl window send to %(MONITOR_BENQ)"
:var "CMD_MOVE_TO_AOC" "octl window send to %(MONITOR_AOC)"
:var "CMD_MOVE_TO_HP" "octl window send to %(MONITOR_HP)"

# Screenshot utilities (use slurp for window mode)
:var "CMD_GET_WINDOW_GEOMETRY" "slurp"

# Workflow workspace assignments (indices; match init.nix window rules)
:var "WS_EMACS" "2"
:var "WS_FIREFOX" "3"
:var "WS_GAMES" "4"
:var "WS_CHROMIUM" "4"
:var "WS_FEEDS" "5"
:var "WS_KEEPASSXC" "9"
:var "WS_SUPERSONIC" "9"

# DE commands
:var "CMD_DE_EXIT" "uwsm stop"

:include "../common/main.wks"
:include "window-management.wks"
