# River entry point for WK
# This file is used when launching wk from River
# It includes common bindings and River-specific window management

# River-specific variable definitions
# Workspace numbers
:var "WS_1" "1"
:var "WS_2" "2"
:var "WS_3" "3"
:var "WS_4" "4"
:var "WS_5" "5"
:var "WS_6" "6"
:var "WS_7" "7"
:var "WS_8" "8"
:var "WS_9" "9"

# Monitors
:var "MONITOR_LEFT" "DP-3"
:var "MONITOR_RIGHT" "HDMI-A-1"

# Window management commands
:var "CMD_CLOSE_WINDOW" "riverdo delay 0.1 close"
:var "CMD_TOGGLE_FLOAT" "riverdo delay 0.1 toggle-float"
:var "CMD_TOGGLE_FULLSCREEN" "riverctl toggle-fullscreen"

# Directional window focus/swap (River-specific)
:var "CMD_FOCUS_NEXT" "riverctl focus-view next"
:var "CMD_FOCUS_PREV" "riverctl focus-view previous"
:var "CMD_FOCUS_DOWN" "riverctl focus-view down"
:var "CMD_FOCUS_UP" "riverctl focus-view up"
:var "CMD_SWAP_DOWN" "riverctl swap down"
:var "CMD_SWAP_UP" "riverctl swap up"

# Tag operations using riverdo (parametric - use with %(index+1))
:var "CMD_SWITCH_WS" "riverdo set-focused-tags"
:var "CMD_MOVE_TO_WS" "riverdo set-view-tags"

# Relative tag navigation (riverdo)
:var "CMD_WS_NEXT" "riverdo shift-tag next --occupied"
:var "CMD_WS_PREV" "riverdo shift-tag previous --occupied"
:var "CMD_MOVE_NEXT" "riverdo shift-view next --occupied"
:var "CMD_MOVE_PREV" "riverdo shift-view previous --occupied"

# Monitor/output operations
:var "CMD_MOVE_TO_MONITOR_LEFT" "riverdo send-to-output %(MONITOR_LEFT) --current-tags"
:var "CMD_MOVE_TO_MONITOR_RIGHT" "riverdo send-to-output %(MONITOR_RIGHT) --current-tags"

# Screenshot utilities (use slurp for window mode)
:var "CMD_GET_WINDOW_GEOMETRY" "slurp"

# Workflow workspace assignments (River uses tags 1-32)
:var "WS_EMACS" "2"
:var "WS_FIREFOX" "3"
:var "WS_GAMES" "4"
:var "WS_CHROMIUM" "4"
:var "WS_FEEDS" "5"
:var "WS_KEEPASSXC" "9"
:var "WS_SUPERSONIC" "9"

:include "common/main.wks"
:include "river/window-management.wks"
