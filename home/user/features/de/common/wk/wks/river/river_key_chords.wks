# River 0.4.x entry point for WK
# Used when launching wk from River 0.4.x (with zrwm).
# All actions go through zrwm-msg (zrwm's IPC tool), since River 0.4.x
# removed riverctl and there's no riverdo equivalent for this variant.

# River 0.4.x uses tag bitmasks: tag N = (1 << (N-1))
:var "WS_1" "1"
:var "WS_2" "2"
:var "WS_3" "4"
:var "WS_4" "8"
:var "WS_5" "16"
:var "WS_6" "32"
:var "WS_7" "64"
:var "WS_8" "128"
:var "WS_9" "256"

# Window management commands (zrwm-msg)
:var "CMD_CLOSE_WINDOW" "zrwm-msg killwindow"
:var "CMD_TOGGLE_FLOAT" "zrwm-msg togglefloating"
:var "CMD_TOGGLE_FULLSCREEN" "zrwm-msg togglefullscreen"

# Stack navigation
:var "CMD_FOCUS_NEXT" "zrwm-msg focusstack 1"
:var "CMD_FOCUS_PREV" "zrwm-msg focusstack -1"
:var "CMD_FOCUS_DOWN" "zrwm-msg focusstack 1"
:var "CMD_FOCUS_UP" "zrwm-msg focusstack -1"
:var "CMD_SWAP_DOWN" "zrwm-msg pushdown"
:var "CMD_SWAP_UP" "zrwm-msg pushup"

# Tag operations (parametric via raw bitmask args)
:var "CMD_SWITCH_WS" "zrwm-msg view"
:var "CMD_GO_WORKSPACE" "zrwm-msg view"
:var "CMD_MOVE_TO_WS" "zrwm-msg tag"

# Relative tag navigation: not supported by zrwm directly. Stubbed to no-op
# (or to single-tag bindings) until a wrapper exists.
:var "CMD_WS_NEXT" "true"
:var "CMD_WS_PREV" "true"
:var "CMD_MOVE_NEXT" "true"
:var "CMD_MOVE_PREV" "true"

# Screenshot utilities
:var "CMD_GET_WINDOW_GEOMETRY" "slurp"

# Workflow workspace assignments (bitmask values)
:var "WS_EMACS" "2"
:var "WS_FIREFOX" "4"
:var "WS_GAMES" "8"
:var "WS_CHROMIUM" "8"
:var "WS_FEEDS" "16"
:var "WS_KEEPASSXC" "256"
:var "WS_SUPERSONIC" "256"

# DE commands
:var "CMD_DE_EXIT" "uwsm stop"

:include "../common/main.wks"
:include "window-management.wks"
