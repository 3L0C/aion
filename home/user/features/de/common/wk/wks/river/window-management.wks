# River 0.4.x window and tag management (via zrwm-msg)
# Multi-output / cross-output operations are not currently exposed; revisit
# once zrwm or ocdwm provides equivalents.

c "Client"
{
    q "Quit" %{{zrwm-msg killwindow}}
    f "Toggle float" %{{zrwm-msg togglefloating}}
    F "Toggle fullscreen" %{{zrwm-msg togglefullscreen}}
    s "Toggle sticky" %{{zrwm-msg togglesticky}}
    t "Tag" +keep
    {
        1 "Tag 1" %{{zrwm-msg tag 1}}
        2 "Tag 2" %{{zrwm-msg tag 2}}
        3 "Tag 3" %{{zrwm-msg tag 4}}
        4 "Tag 4" %{{zrwm-msg tag 8}}
        5 "Tag 5" %{{zrwm-msg tag 16}}
        6 "Tag 6" %{{zrwm-msg tag 32}}
        7 "Tag 7" %{{zrwm-msg tag 64}}
        8 "Tag 8" %{{zrwm-msg tag 128}}
        9 "Tag 9" %{{zrwm-msg tag 256}}
    }
}

w "Window"
{
    t "View tags" +keep
    {
        1 "View tag 1" %{{zrwm-msg view 1}}
        2 "View tag 2" %{{zrwm-msg view 2}}
        3 "View tag 3" %{{zrwm-msg view 4}}
        4 "View tag 4" %{{zrwm-msg view 8}}
        5 "View tag 5" %{{zrwm-msg view 16}}
        6 "View tag 6" %{{zrwm-msg view 32}}
        7 "View tag 7" %{{zrwm-msg view 64}}
        8 "View tag 8" %{{zrwm-msg view 128}}
        9 "View tag 9" %{{zrwm-msg view 256}}
    }
    l "Layout" +keep
    {
        s "split_tile" %{{zrwm-msg setlayout split_tile}}
        d "deck" %{{zrwm-msg setlayout deck}}
        f "float" %{{zrwm-msg setlayout float}}
    }
    r "Reload zrwm" %{{zrwm-msg reload}}
}
