# River 0.4.x window and tag management (via octl/ocdwm)
# Mirrors the river-classic menus minus features ocdwm lacks:
# sticky and swap-outputs (see doc/2026-07-19-ocdwm-gap-list.md).

c "Client"
{
    l "Tag Right" +keep %{{%(CMD_WS_NEXT)}}
    h "Tag Left" +keep %{{%(CMD_WS_PREV)}}
    # Move to output (--take = window takes destination's active tags)
    A "AOC (take tags)" %{{%(CMD_MOVE_TO_AOC) --take}}
    B "BenQ (take tags)" %{{%(CMD_MOVE_TO_BENQ) --take}}
    H "HP (take tags)" %{{%(CMD_MOVE_TO_HP) --take}}
    m "HP" %{{%(CMD_MOVE_TO_HP)}}
    n "BenQ" %{{%(CMD_MOVE_TO_BENQ)}}
    e "AOC" %{{%(CMD_MOVE_TO_AOC)}}
    o "Output" +keep
    {
        a "AOC" %{{%(CMD_MOVE_TO_AOC)}}
        A "AOC & follow" %{{%(CMD_MOVE_TO_AOC) && octl output focus name %(MONITOR_AOC)}}
        b "BenQ" %{{%(CMD_MOVE_TO_BENQ)}}
        B "BenQ & follow" %{{%(CMD_MOVE_TO_BENQ) && octl output focus name %(MONITOR_BENQ)}}
        h "HP" %{{%(CMD_MOVE_TO_HP)}}
        H "HP & follow" %{{%(CMD_MOVE_TO_HP) && octl output focus name %(MONITOR_HP)}}
    }
    q "Quit" %{{%(CMD_CLOSE_WINDOW)}}
    f "Toggle float" %{{%(CMD_TOGGLE_FLOAT)}}
    F "Toggle fullscreen" %{{%(CMD_TOGGLE_FULLSCREEN)}}
    t "Tag" +keep
    {
        ... "Tag %(index+1)" %{{%(CMD_MOVE_TO_WS) %(index+1)}}
    }
}

w "Window"
{
    t "View tags" +keep
    {
        ... "View tag %(index+1)" %{{%(CMD_SWITCH_WS) %(index+1)}}
    }
    l "Layout" +keep
    {
        t "tile" %{{octl set layout tile}}
        m "monocle" %{{octl set layout monocle}}
        f "floating" %{{octl set layout floating}}
        s "Stack" +keep
        {
            e "even" %{{octl set stack even}}
            d "dwindle" %{{octl set stack dwindle}}
            i "diminish" %{{octl set stack diminish}}
        }
    }
    r "Restart ocdwm" %{{systemctl --user restart ocdwm}}
}
