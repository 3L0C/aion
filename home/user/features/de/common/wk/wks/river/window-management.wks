# River-specific window and tag management
# River has unique directional window navigation that doesn't exist in Hyprland
# Most common functionality is in common/window-management.wks

# River-specific: Directional window focus and swap
# These commands extend the common window management with River's tiling features
c "Client"
{
    # Directional focus (River-specific - not in Hyprland)
    j "Focus down" +keep %{{%(CMD_FOCUS_DOWN)}}
    k "Focus up" +keep %{{%(CMD_FOCUS_UP)}}
    # h/l are used for workspace navigation in common/window-management.wks

    # Directional swap (River-specific - not in Hyprland)
    J "Swap down" +keep %{{%(CMD_SWAP_DOWN)}}
    K "Swap up" +keep %{{%(CMD_SWAP_UP)}}
    # H/L are used for monitor navigation in common/window-management.wks
}

# River window toggles
w "Window"
{
    f "Toggle fullscreen" %{{%(CMD_TOGGLE_FULLSCREEN)}}
    t "Toggle float" %{{%(CMD_TOGGLE_FLOAT)}}
}
