# River-specific window and tag management
# River has unique directional window navigation that doesn't exist in Hyprland
# Most common functionality is in common/window-management.wks

# River-specific: Directional window focus and swap
# These commands extend the common window management with River's tiling features
c "Client"
{
    l "Tag Right" +keep %{{%(CMD_WS_NEXT)}}
    L "Mon Right" %{{%(CMD_MOVE_TO_MONITOR_RIGHT)}}
    h "Tag Left" +keep %{{%(CMD_WS_PREV)}}
    H "Mon Left" %{{%(CMD_MOVE_TO_MONITOR_LEFT)}}
    # Tag & follow
    m "Tag & follow" +keep
    {
        ... "Tag %(index+1)" %{{riverdo set-view-tags %(index+1) --follow}}
    }
    q "Quit" %{{riverdo close}}
    s "Stick (occupied)" %{{riverdo stick --tags occupied}}
    S "Stick (all)" %{{riverdo stick}}
    u "Unstick" %{{riverdo unstick}}
    t "Tag"
    {
        ... "Tag %(index+1)" %{{riverdo set-view-tags %(index+1)}}
    }
}

# River window toggles
w "Window"
{
    s "Swap Outputs"
    {
        ... "Swap tags %(index+1)" %{{riverdo swap-outputs --tags %(index+1)}}
        SPC "Swap focused tag" %{{riverdo swap-outputs --focused-tag}}
    }
    t "View tags" +keep
    {
        ... "View tag %(index+1)" %{{riverdo set-focused-tags %(index+1)}}
    }
}
