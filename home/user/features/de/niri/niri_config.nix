{
  config,
  lib,
  pkgs,
  ...
}: let
  mod = config.userSpec.modifierKeys.niri;
  kitty = lib.getExe pkgs.kitty;
  uwsm = lib.getExe pkgs.uwsm;
  pamixer = lib.getExe pkgs.pamixer;
  brightnessctl = lib.getExe pkgs.brightnessctl;
  rofi = lib.getExe config.programs.rofi.finalPackage;
  monitor = config.primaryMonitor;
  envBlock = lib.concatStrings (
    lib.mapAttrsToList (n: v: "        ${n} \"${v}\"\n") config.wayland.envVars
  );
in {
  home.packages = with pkgs; [
    grim # Screenshot tool
    slurp # Area selection
    wev # Wayland event viewer
    wl-clipboard # Clipboard utilities
    xwayland-satellite # XWayland support for Niri
  ];
  xdg.configFile."niri/config.kdl".text = ''
        // Niri configuration - generated by home-manager
        // Keybindings mirror River where possible

        // Wayland environment variables (from config.wayland.envVars)
        environment {
    ${envBlock}    }

        // Input configuration
        input {
            keyboard {
                xkb {
                    layout "${config.userSpec.kbdLayout}"
                    ${lib.optionalString (config.userSpec.kbdVariant != "") ''variant "${config.userSpec.kbdVariant}"''}
                    ${lib.optionalString (config.userSpec.kbdOptions != "") ''options "${config.userSpec.kbdOptions}"''}
                }
                repeat-delay 300
                repeat-rate 50
            }

            touchpad {
                tap
                natural-scroll
            }

            mouse {
                // off disables mouse acceleration
                // accel-speed 0.0
            }

            focus-follows-mouse max-scroll-amount="0%"
        }

        // Output/monitor configuration
        output "${monitor.name}" {
            mode "${toString monitor.width}x${toString monitor.height}@${lib.strings.floatToString monitor.refreshRate}"
            scale ${monitor.scale}
            position x=0 y=0
        }

        // Layout settings
        layout {
            gaps 8

            // Column widths presets
            preset-column-widths {
                proportion 0.33333
                proportion 0.5
                proportion 0.66667
                proportion 1.0
            }

            // Default column width
            default-column-width { proportion 0.5; }

            // Focus ring (border for focused window)
            focus-ring {
                width 4
                active-color "#7e9cd8"
                inactive-color "#54546d"
            }

            // Border for all windows
            border {
                off
            }
        }

        // Spawn at startup
        spawn-at-startup "${lib.getExe pkgs.waybar}" "-c" "${config.xdg.configHome}/waybar/niri-config.json"
        spawn-at-startup "${lib.getExe pkgs.xwayland-satellite}"

        // Cursor settings
        cursor {
            xcursor-theme "Adwaita"
            xcursor-size 24
            hide-when-typing
            hide-after-inactive-ms 5000
        }

        // Prefer server-side decorations
        prefer-no-csd

        // Screenshot path
        screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

        // Hotkey overlay (shows available bindings)
        hotkey-overlay {
            skip-at-startup
        }

        // Keybindings
        binds {
            // Terminal
            ${mod}+Return { spawn "${kitty}" "tmux"; }
            ${mod}+Shift+Return { spawn "${kitty}"; }

            // Launcher
            ${mod}+R { spawn "${rofi}" "-show" "drun"; }

            // Menu (wk)
            ${mod}+Comma { spawn "wk-niri"; }
            ${mod}+O { spawn "wk-niri" "--press" "o"; }
            ${mod}+E { spawn "wk-niri" "--press" "e"; }

            // Close window
            ${mod}+Q { close-window; }

            // Exit compositor
            ${mod}+Shift+Q { spawn "${uwsm}" "stop"; }

            // Focus navigation (column = left/right, window = up/down in column)
            ${mod}+H { focus-column-left; }
            ${mod}+L { focus-column-right; }
            ${mod}+J { focus-window-down; }
            ${mod}+K { focus-window-up; }

            // Move window/column (Shift variants)
            ${mod}+Shift+H { move-column-left; }
            ${mod}+Shift+L { move-column-right; }
            ${mod}+Shift+J { move-window-down-or-to-workspace-down; }
            ${mod}+Shift+K { move-window-up-or-to-workspace-up; }

            // Workspace navigation
            ${mod}+U { focus-workspace-up; }
            ${mod}+I { focus-workspace-down; }
            ${mod}+Tab { focus-workspace-down; }
            ${mod}+Shift+Tab { focus-workspace-up; }

            // Move window to workspace
            ${mod}+Shift+U { move-column-to-workspace-up; }
            ${mod}+Shift+I { move-column-to-workspace-down; }

            // Specific workspaces (1-9)
            ${mod}+1 { focus-workspace 1; }
            ${mod}+2 { focus-workspace 2; }
            ${mod}+3 { focus-workspace 3; }
            ${mod}+4 { focus-workspace 4; }
            ${mod}+5 { focus-workspace 5; }
            ${mod}+6 { focus-workspace 6; }
            ${mod}+7 { focus-workspace 7; }
            ${mod}+8 { focus-workspace 8; }
            ${mod}+9 { focus-workspace 9; }

            // Move to specific workspace
            ${mod}+Shift+1 { move-column-to-workspace 1; }
            ${mod}+Shift+2 { move-column-to-workspace 2; }
            ${mod}+Shift+3 { move-column-to-workspace 3; }
            ${mod}+Shift+4 { move-column-to-workspace 4; }
            ${mod}+Shift+5 { move-column-to-workspace 5; }
            ${mod}+Shift+6 { move-column-to-workspace 6; }
            ${mod}+Shift+7 { move-column-to-workspace 7; }
            ${mod}+Shift+8 { move-column-to-workspace 8; }
            ${mod}+Shift+9 { move-column-to-workspace 9; }

            // Monitor navigation (Shift+Ctrl+Alt = meh)
            Shift+Ctrl+Alt+J { focus-monitor-next; }
            Shift+Ctrl+Alt+K { focus-monitor-previous; }
            Shift+Ctrl+Alt+H { move-column-to-monitor-left; }
            Shift+Ctrl+Alt+L { move-column-to-monitor-right; }

            // Toggle floating
            ${mod}+Shift+Space { toggle-window-floating; }
            ${mod}+Space { switch-focus-between-floating-and-tiling; }

            // Fullscreen
            ${mod}+V { fullscreen-window; }

            // Column width presets (like River layout switching)
            ${mod}+F { maximize-column; }
            ${mod}+Minus { set-column-width "-10%"; }
            ${mod}+Equal { set-column-width "+10%"; }

            // Consume/expel window from column (niri-specific)
            ${mod}+BracketLeft { consume-window-into-column; }
            ${mod}+BracketRight { expel-window-from-column; }

            // Center column
            ${mod}+C { center-column; }

            // Media keys - Volume
            XF86AudioRaiseVolume allow-when-locked=true { spawn "${pamixer}" "-i" "5"; }
            XF86AudioLowerVolume allow-when-locked=true { spawn "${pamixer}" "-d" "5"; }
            XF86AudioMute allow-when-locked=true { spawn "${pamixer}" "--toggle-mute"; }

            // Media keys - Player control
            XF86AudioPlay allow-when-locked=true { spawn "media" "--toggle"; }
            XF86AudioPrev allow-when-locked=true { spawn "media" "--prev"; }
            XF86AudioNext allow-when-locked=true { spawn "media" "--next"; }

            // Media keys - Brightness
            XF86MonBrightnessUp allow-when-locked=true { spawn "${brightnessctl}" "set" "+5%"; }
            XF86MonBrightnessDown allow-when-locked=true { spawn "${brightnessctl}" "set" "5%-"; }

            // Screenshot
            Print { screenshot; }
            ${mod}+Print { screenshot-screen; }
            ${mod}+Shift+Print { screenshot-window; }

            // Power actions (via wk menu)
            ${mod}+Delete { spawn "wk-niri" "--press" "q"; }
        }

        // Window rules
        window-rule {
            // Make all windows slightly transparent when unfocused
            opacity 1.0
        }

        window-rule {
            match app-id="firefox"
            open-on-workspace "3"
        }

        window-rule {
            match app-id="discord"
            open-on-workspace "1"
        }

        window-rule {
            match app-id="org.keepassxc.KeePassXC"
            open-on-workspace "9"
        }

        // Float rules
        window-rule {
            match app-id="pavucontrol"
            open-floating true
        }

        window-rule {
            match app-id="blueman-manager"
            open-floating true
        }

        window-rule {
            match title="Picture-in-Picture"
            open-floating true
        }
  '';
}
