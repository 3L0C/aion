;; ASUS ROG Zephyrus G16 2025 (GU605CR) keyboard configuration
;; Based on T430.kbd - vim navigation, tap-hold modifiers, tmux integration

;; Source layout - ASUS G16 ANSI with media keys row
(defsrc
  vold volu mute prog1
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  del
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '         ret
  lsft z    x    c    v    b    n    m    ,    .    /              rsft
  lctl wkup lmet lalt           spc            ralt cmp  up   left down rght
)

;; Aliases - following T430.kbd conventions
;; t = tap, l = layer
;; Second letter is tap key, third is hold modifier/action
(defalias
  ;; Navigation (with shift for selection)
  bck   C-S-left
  wrd   C-S-rght
  cpy   C-c
  cut   C-x
  pst   C-v
  rev   C-z
  rdo   C-y

  ;; Layer switching
  lnv   (layer-next   vim)
  lsb   (layer-switch base)
  lsi   (layer-switch brs-ins)
  lsv   (layer-switch vim)

  ;; Tap-hold modifiers
  tas   (tap-hold-next-release  200   a     lmet)      ;; tap a, hold meta
  tbc   (tap-hold-next-release  200   @lsb  lctl)      ;; tap switch-base, hold ctrl
  tes   (tap-hold-next-release  200   esc   lsft)      ;; tap esc, hold shift
  trm   (tap-hold-next-release  200   ret   C-A-lsft)  ;; tap return, hold meh
  tss   (tap-hold-next-release  200   spc   lmet)      ;; tap space, hold meta
  ;; C-b tap with pause for tmux prefix recognition
  ;; Using (around lctl (around b (pause 50))) gives the keypress duration
  tta   (tap-hold-next-release  200   (around lctl (around b (pause 50)))   lalt)
  ttm   (tap-hold-next-release  200   tab   C-A-lsft)  ;; tap tab, hold meh
  tts   (tap-hold-next-release  200   (around lctl (around b (pause 50)))   lsft)
  tva   (tap-hold-next-release  200   @lnv  lalt)      ;; tap layer-next vim, hold alt
  tvc   (tap-hold-next-release  200   @lsv  lctl)      ;; tap layer-switch vim, hold ctrl
  tvs   (tap-hold-next-release  200   @lsv  lmet)      ;; tap layer-switch vim, hold meta

  ;; Vim macros (ZZ = save+quit, ZQ = quit without save)
  vms   #(S-z P10 S-z)
  vmq   #(S-z P10 S-q)
)

;; Base layer - QWERTY with tap-hold modifiers
(deflayer base
  _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  @ttm _    _    _    _    _    _    _    _    _    _    _    _    _
  @tes @tas _    _    _    _    _    _    _    _    _    _         @trm
  lctl _    _    _    _    _    _    _    _    _    _              @tts
  _    _    @tvs @tta           @tss           @tva @tvc _    _    _    _
)

;; Vim layer - navigation and vim-style commands
(deflayer vim
  _    _    _    _
  @lsb _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @vmq @wrd @wrd @rdo _    @cpy @rev @lsi _    @pst _    _    _
  @lsi _    del  @cut _    _    left down up   rght _    _         @trm
  lctl @vms _    _    _    @bck _    _    _    _    _              @tts
  _    @lsb @lsb _              @tss           _    _    @lsb _    _    _
)

;; Browser insert layer - for text input in browser while having vim access
(deflayer brs-ins
  _    _    _    _
  @lsb _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  @lsv _    _    _    _    _    _    _    _    _    _    _         _
  lctl _    _    _    _    _    _    _    _    _    _              _
  _    @tbc _    _              @tss           _    _    _    _    _    _
)
