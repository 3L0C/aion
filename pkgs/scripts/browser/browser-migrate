#!/usr/bin/env bash
#
# Browser Profile Migration Script
# Migrates Firefox and Librewolf profiles between machines
#

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() { echo -e "${BLUE}[INFO]${NC} $*"; }
log_success() { echo -e "${GREEN}[OK]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*"; }

usage() {
    cat <<EOF
Usage: $(basename "$0") <command> [options]

Commands:
    export              Create archives of browser profiles (run on source machine)
    import              Import browser profiles from archives (run on destination machine)
    transfer <host>     Export and transfer archives to remote host via scp

Options:
    -d, --dir <path>    Directory for archives (default: ~/browser-migration)
    -f, --firefox       Only process Firefox
    -l, --librewolf     Only process Librewolf
    -h, --help          Show this help message

Examples:
    # On source machine (yuki):
    $(basename "$0") export
    $(basename "$0") transfer haruhi

    # On destination machine (haruhi):
    $(basename "$0") import

    # Only migrate Firefox:
    $(basename "$0") export -f
    $(basename "$0") import -f
EOF
    exit "${1:-0}"
}

# Default settings
ARCHIVE_DIR="$HOME/browser-migration"
DO_FIREFOX=true
DO_LIBREWOLF=true

# Browser paths
FIREFOX_DIR="$HOME/.mozilla/firefox"
LIBREWOLF_DIR="$HOME/.librewolf"

parse_args() {
    local positional=()

    while [[ $# -gt 0 ]]; do
        case $1 in
            -d|--dir)
                ARCHIVE_DIR="$2"
                shift 2
                ;;
            -f|--firefox)
                DO_FIREFOX=true
                DO_LIBREWOLF=false
                shift
                ;;
            -l|--librewolf)
                DO_FIREFOX=false
                DO_LIBREWOLF=true
                shift
                ;;
            -h|--help)
                usage 0
                ;;
            -*)
                log_error "Unknown option: $1"
                usage 1
                ;;
            *)
                positional+=("$1")
                shift
                ;;
        esac
    done

    set -- "${positional[@]}"
    COMMAND="${1:-}"
    REMOTE_HOST="${2:-}"
}

check_browser_running() {
    local browser="$1"
    if pgrep -x "$browser" > /dev/null 2>&1; then
        log_error "$browser is running. Please close it before proceeding."
        return 1
    fi
    return 0
}

export_profiles() {
    log_info "Exporting browser profiles..."

    # Check browsers aren't running
    if $DO_FIREFOX && ! check_browser_running "firefox"; then
        exit 1
    fi
    if $DO_LIBREWOLF && ! check_browser_running "librewolf"; then
        exit 1
    fi

    # Create archive directory
    mkdir -p "$ARCHIVE_DIR"

    # Export Firefox
    if $DO_FIREFOX; then
        if [[ -d "$FIREFOX_DIR" ]]; then
            log_info "Archiving Firefox profile..."
            tar -czvf "$ARCHIVE_DIR/firefox-profile.tar.gz" -C "$HOME" .mozilla/firefox
            log_success "Firefox profile archived: $ARCHIVE_DIR/firefox-profile.tar.gz"
        else
            log_warn "Firefox profile directory not found: $FIREFOX_DIR"
        fi
    fi

    # Export Librewolf
    if $DO_LIBREWOLF; then
        if [[ -d "$LIBREWOLF_DIR" ]]; then
            log_info "Archiving Librewolf profile..."
            tar -czvf "$ARCHIVE_DIR/librewolf-profile.tar.gz" -C "$HOME" .librewolf
            log_success "Librewolf profile archived: $ARCHIVE_DIR/librewolf-profile.tar.gz"
        else
            log_warn "Librewolf profile directory not found: $LIBREWOLF_DIR"
        fi
    fi

    echo
    log_success "Export complete! Archives saved to: $ARCHIVE_DIR"
    log_info "Next steps:"
    echo "  1. Transfer archives to destination: $(basename "$0") transfer <hostname>"
    echo "  2. Or manually: scp $ARCHIVE_DIR/*.tar.gz <hostname>:~/browser-migration/"
}

transfer_profiles() {
    if [[ -z "$REMOTE_HOST" ]]; then
        log_error "Remote host required. Usage: $(basename "$0") transfer <hostname>"
        exit 1
    fi

    log_info "Transferring profiles to $REMOTE_HOST..."

    # Check archive directory exists
    if [[ ! -d "$ARCHIVE_DIR" ]]; then
        log_error "Archive directory not found: $ARCHIVE_DIR"
        log_info "Run '$(basename "$0") export' first."
        exit 1
    fi

    # Create remote directory and transfer
    ssh "$REMOTE_HOST" "mkdir -p ~/browser-migration"

    local files_to_transfer=()
    if $DO_FIREFOX && [[ -f "$ARCHIVE_DIR/firefox-profile.tar.gz" ]]; then
        files_to_transfer+=("$ARCHIVE_DIR/firefox-profile.tar.gz")
    fi
    if $DO_LIBREWOLF && [[ -f "$ARCHIVE_DIR/librewolf-profile.tar.gz" ]]; then
        files_to_transfer+=("$ARCHIVE_DIR/librewolf-profile.tar.gz")
    fi

    if [[ ${#files_to_transfer[@]} -eq 0 ]]; then
        log_error "No archive files found to transfer."
        exit 1
    fi

    scp "${files_to_transfer[@]}" "$REMOTE_HOST:~/browser-migration/"

    echo
    log_success "Transfer complete!"
    log_info "On $REMOTE_HOST, run: $(basename "$0") import"
}

import_profiles() {
    log_info "Importing browser profiles..."

    # Check browsers aren't running
    if $DO_FIREFOX && ! check_browser_running "firefox"; then
        exit 1
    fi
    if $DO_LIBREWOLF && ! check_browser_running "librewolf"; then
        exit 1
    fi

    # Check archive directory
    if [[ ! -d "$ARCHIVE_DIR" ]]; then
        log_error "Archive directory not found: $ARCHIVE_DIR"
        exit 1
    fi

    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)

    # Import Firefox
    if $DO_FIREFOX; then
        local firefox_archive="$ARCHIVE_DIR/firefox-profile.tar.gz"
        if [[ -f "$firefox_archive" ]]; then
            # Backup existing
            if [[ -d "$FIREFOX_DIR" ]]; then
                log_info "Backing up existing Firefox profile..."
                mv "$FIREFOX_DIR" "${FIREFOX_DIR}.bak.${timestamp}"
                log_success "Backup created: ${FIREFOX_DIR}.bak.${timestamp}"
            fi

            # Extract new profile
            log_info "Extracting Firefox profile..."
            mkdir -p "$HOME/.mozilla"
            tar -xzvf "$firefox_archive" -C "$HOME"
            chmod -R u+rw "$FIREFOX_DIR"
            log_success "Firefox profile imported"
        else
            log_warn "Firefox archive not found: $firefox_archive"
        fi
    fi

    # Import Librewolf
    if $DO_LIBREWOLF; then
        local librewolf_archive="$ARCHIVE_DIR/librewolf-profile.tar.gz"
        if [[ -f "$librewolf_archive" ]]; then
            # Backup existing
            if [[ -d "$LIBREWOLF_DIR" ]]; then
                log_info "Backing up existing Librewolf profile..."
                mv "$LIBREWOLF_DIR" "${LIBREWOLF_DIR}.bak.${timestamp}"
                log_success "Backup created: ${LIBREWOLF_DIR}.bak.${timestamp}"
            fi

            # Extract new profile
            log_info "Extracting Librewolf profile..."
            tar -xzvf "$librewolf_archive" -C "$HOME"
            chmod -R u+rw "$LIBREWOLF_DIR"
            log_success "Librewolf profile imported"
        else
            log_warn "Librewolf archive not found: $librewolf_archive"
        fi
    fi

    echo
    log_success "Import complete!"
    echo
    log_info "Next steps:"
    echo "  1. Launch browsers with profile manager to verify:"
    $DO_FIREFOX && echo "     firefox -P"
    $DO_LIBREWOLF && echo "     librewolf -P"
    echo "  2. Or check profiles at: about:profiles"
    echo
    log_info "If profiles don't appear, select 'Create Profile' and point to the imported directory."
}

# Main
parse_args "$@"

case "${COMMAND:-}" in
    export)
        export_profiles
        ;;
    import)
        import_profiles
        ;;
    transfer)
        transfer_profiles
        ;;
    "")
        log_error "No command specified."
        usage 1
        ;;
    *)
        log_error "Unknown command: $COMMAND"
        usage 1
        ;;
esac
