#!/usr/bin/env bash
# Toggle touchpad on/off using riverctl
# State is tracked in $XDG_RUNTIME_DIR/touchpad-state

STATE_FILE="${XDG_RUNTIME_DIR}/touchpad-state"

if [[ -f "$STATE_FILE" && "$(cat "$STATE_FILE")" == "disabled" ]]; then
    riverctl input "*Touchpad*" events enabled
    echo "enabled" > "$STATE_FILE"
else
    riverctl input "*Touchpad*" events disabled
    echo "disabled" > "$STATE_FILE"
fi
