#!/usr/bin/env bash

handle_block() {
    case $BLOCK_BUTTON in
        1)
            mpc next
            ;;
    esac
}

mpc_status() {
    if [[ "$(mpc)" =~ "volume: n/a   r" ]]; then
        MPC_STOPPED=1
    elif [[ "$(mpc status %state%)" == "paused" ]]; then
        MPC_PAUSED=1
    else
        MPC_PLAYING=1
    fi
}

mpc_status
handle_block >/dev/null 2>&1
echo "󰒭 "
