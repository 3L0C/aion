#!/usr/bin/env bash

handle_block() {
    case $BLOCK_BUTTON in
        1)
            if [[ "$MPC_STOPPED" -eq 1 ]]; then
                mpc-toggle
            else
                mpc toggle
            fi
            ;;
    esac
}

mpc_status() {
    if [[ "$(mpc)" =~ "volume: n/a   r" ]]; then
        MPC_STOPPED=1
        MPC_ICON="󰐊"
    elif [[ "$(mpc status %state%)" == "paused" ]]; then
        # MPC_PAUSED=1
        MPC_ICON="󰐊"
    else
        # MPC_PLAYING=1
        MPC_ICON="󰏤"
    fi
}

handle_block >/dev/null 2>&1
mpc_status >/dev/null 2>&1
echo "$MPC_ICON "
