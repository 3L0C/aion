#!/usr/bin/env bash

usage() {
    cat <<-EOF
usage: ${0##*/} [option] [--] [files ...]

options:
    -b, --blank          Start Emacs daemon, and blank Emacs frame.
    -d, --dirvish        Start Emacs dirvish session.
    -t, --vterm          Start Emacs vterm in a frame that closes on exit.
    -v, --vanilla        Start a vanilla version of Doom Emacs, no daemon.
EOF
}

abort() {
    echo -e "$@" >&2
    usage
    exit 1
}

get_opts() {
    while [[ "$#" -ne 0 ]]; do
        local SHIFT_COUNT=1
        case "$1" in
        -b | --blank) OPERATION="blank" ;;
        -d | --dirvish) OPERATION="dirvish" ;;
        -t | --vterm) OPERATION="vterm" ;;
        -v | --vanilla) OPERATION="vanilla" ;;
        --)
            FILES+=("$@:2")
            SHIFT_COUNT="$#"
            ;;
        -*) abort "Unrecognized option: $1\nIf file begins with '-' use -- -file ..." ;;
        *)
            FILES+=("$@")
            SHIFT_COUNT="$#"
            ;;
        esac
        shift "$SHIFT_COUNT"
    done
}

doom_maybe_start_daemon() {
    if ! pidof -q emacs; then
        uwsm-app -- doom sync
        uwsm-app -- emacs --daemon
    fi
}

wrap_with_frame_close() {
    local cmd="$1"
    echo "(let ((frame (selected-frame))) $cmd (add-hook 'kill-buffer-hook (lambda () (when (frame-live-p frame) (delete-frame frame))) nil t) nil)"
}

doom_open_vanilla() {
    uwsm-app -- doom --emacsdir ~/.config/emacs-vanilla --doomdir ~/.config/doom-vanilla emacs
}

doom_open() {
    local eval_expr="$1"
    shift
    doom_maybe_start_daemon
    if [[ -n "$eval_expr" ]]; then
        uwsm-app -- emacsclient -c --eval "$eval_expr"
    else
        uwsm-app -- emacsclient -c -a '' "$@"
    fi
}

handle_opts() {
    case "$OPERATION" in
    blank) doom_open "" "${FILES[@]}" ;;
    vanilla) doom_open_vanilla ;;
    dirvish) doom_open "$(wrap_with_frame_close '(dirvish "~/")')" ;;
    vterm) doom_open "$(wrap_with_frame_close '(vterm)')" ;;
    *) abort "Unrecognized operation: $OPERATION" ;;
    esac
}

main() {
    OPERATION="blank"
    FILES=()
    get_opts "$@"
    handle_opts
}

main "$@"
