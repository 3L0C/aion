#!/usr/bin/env bash
# media - Unified media player controller via MPRIS/playerctl

set -euo pipefail

PLAYER="%any"

usage() {
    cat <<EOF
Usage: media [OPTIONS] OPERATION

Unified media player controller via playerctl/MPRIS.

OPERATIONS (required):
    --toggle, -t     Toggle play/pause
    --next, -n       Next track
    --prev, -p       Previous track
    --stop           Stop playback
    --play           Start playback
    --pause          Pause playback
    --status, -s     Show current playback status

TARGETING OPTIONS:
    --player=NAME    Target specific MPRIS player (mpv, mpd, firefox, spotify, etc.)

OTHER OPTIONS:
    -q, --quiet      Suppress output
    -h, --help       Show this help message

EXAMPLES:
    media --toggle              # Toggle active player
    media --next                # Next track on active player
    media --player=mpv --pause  # Pause MPV specifically
    media --player=mpd --next   # Next track on MPD
    media --status              # Show current playback status
EOF
    exit 0
}

# Parse arguments and execute
OPERATION=""
QUIET=0

while [[ "$#" -ne 0 ]]; do
    case "$1" in
        -t | --toggle) OPERATION="play-pause" ;;
        -n | --next) OPERATION="next" ;;
        -p | --prev) OPERATION="previous" ;;
        --stop) OPERATION="stop" ;;
        --play) OPERATION="play" ;;
        --pause) OPERATION="pause" ;;
        -s | --status) OPERATION="status" ;;
        --player=*) PLAYER="${1#--player=}" ;;
        --player) shift; PLAYER="${1:?--player requires a name}" ;;
        -q | --quiet) QUIET=1 ;;
        -h | --help) usage ;;
        *) echo "Error: Unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

[[ -z "$OPERATION" ]] && { echo "Error: No operation specified." >&2; usage >&2; exit 1; }

if [[ "$OPERATION" == "status" ]]; then
    player_name="$(playerctl --player "$PLAYER" --list-all 2>/dev/null | head -n1 || echo "")"
    if [[ -n "$player_name" ]]; then
        status="$(playerctl --player "$player_name" status 2>/dev/null || echo "Stopped")"
        metadata="$(playerctl --player "$player_name" metadata --format '{{artist}} - {{title}}' 2>/dev/null || echo "")"
        [[ -n "$metadata" && "$metadata" != " - " ]] && echo "[$player_name] $status: $metadata" || echo "[$player_name] $status"
    else
        echo "[none] No active players"
    fi
else
    playerctl --player "$PLAYER" "$OPERATION"
fi
