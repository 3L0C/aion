#!/usr/bin/env bash

get_target() {
    if [[ -f "$1" ]]; then
        target="$1"
        rest=("${@:2}")
    else
        target="default.nix"
        rest=("$@")
    fi
}

main() {
    get_target "$@"
    nix-build -E "with import <nixpkgs> { }; callPackage ./$target { }" "${rest[@]}"
}

main "$@"
