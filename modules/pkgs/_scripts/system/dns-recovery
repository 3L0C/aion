#!/usr/bin/env bash
# DNS Recovery Script for DNSSEC/Time Sync Issues
# Use this when dual-booting with Windows causes time desync and breaks DNSSEC validation

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}=== DNS Recovery Script ===${NC}"
echo "This script fixes DNS issues caused by time desync (common after booting Windows)"
echo ""

# Check if running as root
if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}Error: This script must be run as root (use sudo)${NC}"
    exit 1
fi

echo -e "${YELLOW}Step 1: Checking current time and DNSSEC status${NC}"
timedatectl status
echo ""
resolvectl status | grep -i dnssec || true
echo ""

echo -e "${YELLOW}Step 2: Temporarily disabling DNSSEC${NC}"
if grep -q "^DNSSEC=" /etc/systemd/resolved.conf; then
    sed -i 's/^DNSSEC=.*/DNSSEC=no/' /etc/systemd/resolved.conf
    echo "✓ Set DNSSEC=no in resolved.conf"
else
    echo "! DNSSEC not explicitly configured in resolved.conf"
fi

echo -e "${YELLOW}Step 3: Setting up fallback DNS${NC}"
# Backup current resolv.conf
if [ -L /etc/resolv.conf ]; then
    RESOLV_BACKUP=$(readlink -f /etc/resolv.conf)
    echo "! Original resolv.conf: $RESOLV_BACKUP"
fi

rm -f /etc/resolv.conf

# Try multiple public DNS servers (ordered by reliability)
cat > /etc/resolv.conf << EOF
# Temporary DNS fallback - will be restored after rebuild
nameserver 1.1.1.1      # Cloudflare
nameserver 8.8.8.8      # Google
nameserver 9.9.9.9      # Quad9
EOF

echo "✓ Set fallback DNS servers"

echo -e "${YELLOW}Step 4: Restarting systemd-resolved${NC}"
systemctl restart systemd-resolved.service
echo "✓ Restarted systemd-resolved"

echo -e "${YELLOW}Step 5: Flushing DNS cache${NC}"
resolvectl flush-caches 2>/dev/null || echo "! Could not flush cache (might not be using systemd-resolved)"
echo "✓ Attempted to flush DNS cache"

echo -e "${YELLOW}Step 6: Force time sync${NC}"
if systemctl is-active --quiet systemd-timesyncd.service; then
    systemctl restart systemd-timesyncd.service
    echo "✓ Restarted systemd-timesyncd"
    timedatectl set-ntp true 2>/dev/null || true
elif systemctl is-active --quiet ntpd.service; then
    systemctl restart ntpd.service
    echo "✓ Restarted ntpd"
elif systemctl is-active --quiet chronyd.service; then
    systemctl restart chronyd.service
    echo "✓ Restarted chronyd"
else
    echo "! No time sync service found running"
    echo "  Attempting to start systemd-timesyncd..."
    systemctl start systemd-timesyncd.service 2>/dev/null || echo "  Could not start timesyncd"
fi

# Wait for time sync
echo "  Waiting for time sync..."
sleep 3

echo ""
echo "Current time status:"
timedatectl status

echo ""
echo -e "${YELLOW}Step 7: Testing DNS resolution${NC}"
TEST_DOMAINS=("cache.nixos.org" "google.com" "github.com")
SUCCESS=0

for domain in "${TEST_DOMAINS[@]}"; do
    if host "$domain" > /dev/null 2>&1; then
        echo -e "${GREEN}✓ $domain resolved successfully${NC}"
        SUCCESS=1
    else
        echo -e "${RED}✗ $domain failed to resolve${NC}"
    fi
done

echo ""
if [ $SUCCESS -eq 1 ]; then
    echo -e "${GREEN}=== Recovery Successful ===${NC}"
    echo ""
    echo "Next steps:"
    echo "1. You should now be able to run: nh os switch"
    echo "2. After rebuilding, reboot to restore proper systemd-resolved configuration"
    echo "3. To prevent this issue, configure Windows to use UTC:"
    echo "   Run in Windows PowerShell (as Administrator):"
    echo "   reg add \"HKLM\\System\\CurrentControlSet\\Control\\TimeZoneInformation\" /v RealTimeIsUniversal /d 1 /t REG_DWORD /f"
    echo ""
    echo -e "${YELLOW}Note: These changes are temporary and will be reset on next rebuild/reboot${NC}"
else
    echo -e "${RED}=== Recovery Failed ===${NC}"
    echo ""
    echo "DNS resolution is still not working. Additional troubleshooting needed."
    echo "Check if you have network connectivity:"
    echo "  ping -c 2 8.8.8.8"
    echo ""
    echo "Check firewall rules that might be blocking DNS:"
    echo "  nft list ruleset | grep -i dns"
fi
