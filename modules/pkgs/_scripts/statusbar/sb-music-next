#!/usr/bin/env bash

handle_block() {
    case $BLOCK_BUTTON in
        1)
            mpc next
            ;;
    esac
}

mpc_status() {
    # These mirror sb-music's state variables for consistency across the
    # sb-mpv*/sb-music* family, but this particular script's output doesn't
    # branch on them (always prints the "next" icon).
    if [[ "$(mpc)" =~ "volume: n/a   r" ]]; then
        # shellcheck disable=SC2034
        MPC_STOPPED=1
    elif [[ "$(mpc status %state%)" == "paused" ]]; then
        # shellcheck disable=SC2034
        MPC_PAUSED=1
    else
        # shellcheck disable=SC2034
        MPC_PLAYING=1
    fi
}

mpc_status
handle_block >/dev/null 2>&1
echo "󰒭 "
