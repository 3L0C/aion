# Browser binds
b "Browser"
{
    b "Open Brave" %{{brave}}
    f "Open Firefox " %{{firefox}}
    l "Open Librewolf " %{{librewolf}}
    # Mullvad-exclude browser
    m "Mullvad-exclude"
    {
        b "Exclude Brave" %{{mullvad-exclude brave}}
        c "Exclude Chromium" %{{%(CMD_SWITCH_WS) %(WS_CHROMIUM) ; %(wrap_cmd) mullvad-exclude chromium}}
        f "Exclude Firefox" %{{mullvad-exclude firefox}}
        l "Exclude Librewolf" %{{mullvad-exclude librewolf}}
    }
}

# Open programs
o "Open"
{
    e "Emacs" %{{emacs}}
    # dfeed prefix
    f "dfeed" ^before %{{%(CMD_GO_WORKSPACE) %(WS_FEEDS)}}
    {
        s "Seasonal" %{{dfeed --filter-output seasonal_anime --invert --feed anime_torrents}}
        l "List feed" %{{dfeed}}
        p "Pick feed" %{{dfeed --pick}}
    }
    h "hmpv" %{{hmpv}}
    l "emf" %{{emacsclient -s efm -c --eval "(efm)"}}
    L "lf" %{{kitty --name lf_run lf}}
    k "KeePassXC" ^before %{{%(CMD_SWITCH_WS) %(WS_9)}} %{{keepassxc}}
    # Manga options
    m "Manga" ^before %{{%(CMD_GO_WORKSPACE) %(WS_FEEDS)}}
    {
        d "Download" %{{kitty tmux new 'mlm --add "$(xclip -o -selection clipboard)"; date "+%Y%m%d-%H%M%S"; exec zsh -i'}}
        l "Latest" %{{mlm -l}}
        n "New latest" %{{mlm -ln}}
        r "Read" %{{mlm -r}}
        s "Last updated" %{{mlm -rn}}
        u "Update" %{{kitty tmux new 'mlm --download-new; exec zsh -i'}}
    }
    n "ncmpcpp" %{{kitty ncmpcpp}}
    # Other programs
    o "Other programs"
    {
        l "Lutris" %{{lutris}}
        m "OpenMW" ^before %{{%(CMD_SWITCH_WS) %(WS_GAMES)}} %{{openmw-launcher}}
        p "Playlist" %{{dmenuplaylist --list}}
        s "Steam" ^before %{{%(CMD_SWITCH_WS) %(WS_GAMES)}} %{{steam}}
    }
    p "Pulsemixer" %{{kitty --class pulsemixer pulsemixer}}
    r "DrRacket" %{{drracket}}
    # Screenshot prefix
    s "Screenshot" +unwrap
    {
        c "Copy Shot" +unwrap
        {
            f "Full screen" %{{grim - | wl-copy -t image/png}}
            s "Selected area" %{{grim -g "$(slurp)" - | wl-copy -t image/png}}
            w "Window" %{{kitty --app-id=kitten-search -o font_size=16 sh -c 'id="$(window-pick --filter-app-id "^kitten-search$")" && grim -T "$id" - | setsid -f wl-copy -t image/png >/dev/null 2>&1'}}
        }
        f "Full screen" %{{grim pic-full-$(date '+%y%m%d-%H%M-%S').png && notify-send "Screenshot of desktop taken"}}
        s "Selected area" %{{grim -g "$(slurp)" pic-selected-"$(date '+%y%m%d-%H%M-%S').png"}}
        w "Window" %{{kitty --app-id=kitten-search -o font_size=16 sh -c 'id="$(window-pick --filter-app-id "^kitten-search$")" && grim -T "$id" pic-window-$(date +%y%m%d-%H%M-%S).png && notify-send "Screenshot of window taken"'}}
    }
    t "Thunderbird" %{{thunderbird}}
}
