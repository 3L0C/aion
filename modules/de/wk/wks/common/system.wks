# Quit prefix
q "Quit"
{
    c "Close window" %{{%(CMD_CLOSE_WINDOW)}}
    m "mpv" %{{mpv-opts --quit}}
    n "mpc" %{{mpc stop ; mpc clear}}
}

# System binds
s "System"
{
    d "Display off" %{{sysact "%(desc)"}}
    # Binds that I want to be sure before pressing
    D "Dangerous"
    {
        e "Exit" +unwrap %{{%(CMD_DE_EXIT)}}
        r "Reboot" %{{sysact "%(desc)"}}
        s "Shutdown" %{{sysact "%(desc)"}}
    }
    k "Kanshi"
    {
        g "Gaming" %{{kanshictl switch gaming}}
        w "Work" %{{kanshictl switch all}}
    }
    l "Lock" %{{sysact "%(desc)"}}
    r "Renew" %{{sysact "%(desc)"}}
    R "Hard reset" %{{sysact "%(desc)"}}
    s "Sleep" %{{sysact "%(desc)"}}
    v "VPN"
    {
        r "Reconnect" %{{mullvad reconnect}}
    }
}

# Toggle prefix
t "Toggle"
{
    a "Pause all" %{{mpc pause ; pauseallmpv}}
    # Toggle prefix
    b "Toggle Bluetooth"
    {
        a "AirPods connect" %{{dmenubluetooth -r -a}}
        A "AirPods disconnect" %{{dmenubluetooth -d -a}}
        o "Old AirPods connect" %{{dmenubluetooth -r -o}}
        O "Old AirPods disconnect" %{{dmenubluetooth -d -o}}
        p "AirPro connect" %{{dmenubluetooth -r -p}}
        P "AirPro connect" %{{dmenubluetooth -d -p}}
        s "Sony connect" %{{dmenubluetooth -r -s}}
        S "Sony disconnect" %{{dmenubluetooth -d -s}}
        t "Toggle Bluetooth" %{{dmenubluetooth -t}}
    }
    m "mpv" %{{mpv-toggle}}
    n "mpd" %{{media --player=mpd --toggle}}
    u "umpv" %{{mpv-toggle --umpv}}
}
